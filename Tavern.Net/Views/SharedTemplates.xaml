<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
                    xmlns:conv="clr-namespace:Tavern.Net.Converters"
                    xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors">

    <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Implicit (no x:Key, so TargetType alone matches) — every ListBox/TextBox in the app picks
         these up automatically, matching the app's dark (#1A202C) background instead of the
         system default white control chrome. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="CaretBrush" Value="#F7FAFC"/>
        <Setter Property="SelectionBrush" Value="#4A5568"/>
    </Style>

    <!-- Both the closed box and the open dropdown's rows come with their own hardcoded
         system-highlight-blue/white chrome baked into the default ComboBox/ComboBoxItem
         ControlTemplates — plain Background/Foreground setters don't reach the selected-row or
         closed-box visuals, they only get bypassed by supplying our own templates outright. -->
    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A5568"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A5568"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#9662;" Foreground="#F7FAFC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- SelectionBoxItem/SelectionBoxItemTemplate (not the raw selected item) is the
                             documented way to show the closed box's content without an editable text
                             box, and it's what makes TextElement.Foreground below actually apply. -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                           Content="{TemplateBinding SelectionBoxItem}"
                                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None" StaysOpen="False">
                            <Border Background="#2D3748" BorderBrush="#4A5568" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The app's one button look: dark chrome, subtle border, lighter on hover. Every ordinary
         button in the app (menu, deck import, board header actions) uses this explicitly rather
         than an implicit TargetType="Button" style, since a few spots (CounterButtonStyle,
         StatusToggleStyle in GameBoardView) need their own fixed-size variants instead. -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="Background" Value="#1A202C"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A5568"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#718096"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One face-up card: art if loaded, name placeholder otherwise. Left-click taps/untaps it
         (only meaningful on the Field — see GameBoardViewModel.ToggleTapped), drag moves it
         between zones, and right-click immediately opens the full-size zoom overlay. -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardViewModel}">
        <Border Width="125" Height="175" Margin="3" CornerRadius="4" ClipToBounds="True"
                BorderBrush="#55000000" BorderThickness="1"
                Background="#333"
                RenderTransformOrigin="0.5,0.5"
                Cursor="Hand"
                behaviors:CardDragBehavior.IsDraggable="True"
                behaviors:CardZoomBehavior.IsZoomable="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTapped}" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                       Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" Margin="4" FontSize="14"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                <!-- Status/counter badges: tiny and non-interactive (IsHitTestVisible=False) — only
                     ever populated on a Field/Champion card, since GameSession.MoveCard clears
                     both the instant a card goes anywhere else (CardInstance.ResetCounterAndStatuses). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="3" IsHitTestVisible="False">
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ephemeral.png"
                           Visibility="{Binding Instance.IsEphemeral, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ignited.png"
                           Visibility="{Binding Instance.IsIgnited, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/imbued.png"
                           Visibility="{Binding Instance.IsImbued, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ranged.png"
                           Visibility="{Binding Instance.IsRanged, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/rooted.png"
                           Visibility="{Binding Instance.IsRooted, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Source="/GameData/Images/Tokens/warded.png"
                           Visibility="{Binding Instance.IsWarded, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Border Background="#CC000000" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="3" IsHitTestVisible="False"
                        Visibility="{Binding Instance.Counter, Converter={StaticResource IntToVisibility}}">
                    <TextBlock Text="{Binding Instance.Counter}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Champion-zone peek variant: identical to CardTemplate except it never shows the tapped
         rotation. Tap/flip themselves are already no-ops here too (GameBoardViewModel.ToggleTapped
         is Field-only; FlipCard explicitly excludes Champion) — this only covers the visual, since
         a buried or top champion card can carry a real IsTapped that has nothing to do with how
         the stack should read while browsing it here. Dragging (to remove a card from Champion)
         and right-click zoom both stay enabled, unchanged from CardTemplate. -->
    <DataTemplate x:Key="ChampionPeekCardTemplate" DataType="{x:Type vm:CardViewModel}">
        <Border Width="125" Height="175" Margin="3" CornerRadius="4" ClipToBounds="True"
                BorderBrush="#55000000" BorderThickness="1"
                Background="#333"
                Cursor="Hand"
                behaviors:CardDragBehavior.IsDraggable="True"
                behaviors:CardZoomBehavior.IsZoomable="True">
            <Grid>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                       Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" Margin="4" FontSize="14"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="3" IsHitTestVisible="False">
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ephemeral.png"
                           Visibility="{Binding Instance.IsEphemeral, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ignited.png"
                           Visibility="{Binding Instance.IsIgnited, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/imbued.png"
                           Visibility="{Binding Instance.IsImbued, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ranged.png"
                           Visibility="{Binding Instance.IsRanged, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/rooted.png"
                           Visibility="{Binding Instance.IsRooted, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Source="/GameData/Images/Tokens/warded.png"
                           Visibility="{Binding Instance.IsWarded, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Border Background="#CC000000" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="3" IsHitTestVisible="False"
                        Visibility="{Binding Instance.Counter, Converter={StaticResource IntToVisibility}}">
                    <TextBlock Text="{Binding Instance.Counter}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Read-only card visual for the Major-event snapshot viewer — wraps CardSnapshotViewModel
         (immutable CardSnapshot data, not a live CardInstance). No drag/tap/flip behavior, since
         viewing history never mutates the live game, but right-click zoom is still enabled
         (CardZoomBehavior routes CardSnapshotViewModel to GameBoardViewModel.ZoomSnapshotCardCommand
         instead of ZoomCardCommand). -->
    <DataTemplate x:Key="CardSnapshotTemplate" DataType="{x:Type vm:CardSnapshotViewModel}">
        <Border Width="125" Height="175" CornerRadius="4" ClipToBounds="True"
                BorderBrush="#55000000" BorderThickness="1"
                Background="#333"
                RenderTransformOrigin="0.5,0.5"
                Cursor="Hand"
                behaviors:CardZoomBehavior.IsZoomable="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- A tapped card rotates in place without changing its own 125x175 layout
                             box, so the rotated art visually overflows ~25px past each side into
                             its neighbors. Extra left/right margin gives it room to breathe instead
                             of getting clipped by the cards next to it. -->
                        <DataTrigger Binding="{Binding Snapshot.IsTapped}" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="28,3,28,3"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                       Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" Margin="4" FontSize="14"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="3" IsHitTestVisible="False">
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ephemeral.png"
                           Visibility="{Binding Snapshot.IsEphemeral, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ignited.png"
                           Visibility="{Binding Snapshot.IsIgnited, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/imbued.png"
                           Visibility="{Binding Snapshot.IsImbued, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ranged.png"
                           Visibility="{Binding Snapshot.IsRanged, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/rooted.png"
                           Visibility="{Binding Snapshot.IsRooted, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Source="/GameData/Images/Tokens/warded.png"
                           Visibility="{Binding Snapshot.IsWarded, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Border Background="#CC000000" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="3" IsHitTestVisible="False"
                        Visibility="{Binding Snapshot.Counter, Converter={StaticResource IntToVisibility}}">
                    <TextBlock Text="{Binding Snapshot.Counter}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
