<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
                    xmlns:conv="clr-namespace:Tavern.Net.Converters"
                    xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors">

    <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Implicit (no x:Key, so TargetType alone matches) — every ListBox/TextBox in the app picks
         these up automatically, matching the app's dark (#1A202C) background instead of the
         system default white control chrome. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="CaretBrush" Value="#F7FAFC"/>
        <Setter Property="SelectionBrush" Value="#4A5568"/>
    </Style>

    <!-- One face-up card: art if loaded, name placeholder otherwise. Left-click taps/untaps it
         (only meaningful on the Field — see GameBoardViewModel.ToggleTapped), drag moves it
         between zones, and right-click immediately opens the full-size zoom overlay. -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardViewModel}">
        <Border Width="125" Height="175" Margin="3" CornerRadius="4" ClipToBounds="True"
                BorderBrush="#55000000" BorderThickness="1"
                Background="#333"
                RenderTransformOrigin="0.5,0.5"
                Cursor="Hand"
                behaviors:CardDragBehavior.IsDraggable="True"
                behaviors:CardZoomBehavior.IsZoomable="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTapped}" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                       Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" Margin="4" FontSize="14"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                <!-- Status/counter badges: tiny and non-interactive (IsHitTestVisible=False) — only
                     ever populated on a Field/Champion card, since GameSession.MoveCard clears
                     both the instant a card goes anywhere else (CardInstance.ResetCounterAndStatuses). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="3" IsHitTestVisible="False">
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ephemeral.png"
                           Visibility="{Binding Instance.IsEphemeral, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ignited.png"
                           Visibility="{Binding Instance.IsIgnited, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/imbued.png"
                           Visibility="{Binding Instance.IsImbued, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ranged.png"
                           Visibility="{Binding Instance.IsRanged, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/rooted.png"
                           Visibility="{Binding Instance.IsRooted, Converter={StaticResource BoolToVisibility}}"/>
                    <Image Width="16" Height="16" Source="/GameData/Images/Tokens/warded.png"
                           Visibility="{Binding Instance.IsWarded, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Border Background="#CC000000" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="3" IsHitTestVisible="False"
                        Visibility="{Binding Instance.Counter, Converter={StaticResource IntToVisibility}}">
                    <TextBlock Text="{Binding Instance.Counter}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
