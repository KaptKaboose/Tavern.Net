<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:views="clr-namespace:Tavern.Net.Views"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters">
    <!-- Reusable data templates for the game board: pile boxes, deck rows, the phase bar. Merged app-wide by GameBoardResources.xaml (which App.xaml merges), so every
         panel under Views/GameBoard can use them. Each dictionary merges what it depends on, so it also loads on its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Tavern.Net;component/Views/SharedTemplates.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Tavern.Net;component/Views/GameBoard/GameBoardConverters.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Tavern.Net;component/Views/GameBoard/GameBoardStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- A face-down stack with its count, styled like the main board's piles (StackZoneView): the
         generic card back under a translucent scrim with a big centered number. Content is the
         count (an int); the caller supplies the label above it. Used for every hidden stack on the
         opponent panel and the review panel. -->
    <DataTemplate x:Key="FaceDownCountTemplate">
        <Grid Width="125" Height="175">
            <Image Source="pack://application:,,,/GameData/Images/Grand%20Archive%20Back.jpg" Stretch="UniformToFill"/>
            <Border Background="#99222222" CornerRadius="4"/>
            <TextBlock Text="{Binding}" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- One pile box — real card art (or an empty dark box, via IntToVisibility, when the zone
         has no cards) plus a count badge that always shows, including 0. Click opens the full
         contents (ViewSnapshotPileCommand/ViewedSnapshotPile). Shared by the snapshot viewer's
         ViewedSnapshotPiles (an ItemsControl, so AncestorType=UserControl still resolves fine —
         it's a plain visual-tree walk regardless of ItemsControl vs. ContentControl) and the
         opponent panel's three individually-bound piles (OpponentChampionPile/
         OpponentGraveyardPile/OpponentBanishmentPile). -->
    <DataTemplate x:Key="PileBoxTemplate">
        <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.ViewSnapshotPileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid Width="125" Height="175">
                    <Border Background="#1A202C" CornerRadius="4"/>
                    <ContentControl Content="{Binding Cards[0]}" ContentTemplate="{StaticResource CardSnapshotTemplate}" IsHitTestVisible="False"
                                    Visibility="{Binding Cards.Count, Converter={StaticResource IntToVisibility}}"/>
                    <!-- Redacted (a live opponent's Material/Main): a face-down back instead,
                         and not clickable. -->
                    <ContentControl Content="{Binding Count}" ContentTemplate="{StaticResource FaceDownCountTemplate}"
                                    Visibility="{Binding IsRedacted, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            Visibility="{Binding IsNotRedacted, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Count}"/>
                    </Border>
                    <Border BorderBrush="#F6E05E" BorderThickness="3" CornerRadius="4" IsHitTestVisible="False"
                            Effect="{StaticResource GoldGlow}"
                            Visibility="{Binding HasNewArrival, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRedacted}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- The Champion pile, on a row of its own: a 175x175 cell instead of the usual 125x175, so a
         tapped (90-degree rotated) champion fits inside it rather than spilling into its
         neighbors or getting clipped. Otherwise the same as PileBoxTemplate. -->
    <DataTemplate x:Key="ChampionPileTemplate">
        <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.ViewSnapshotPileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid Width="175" Height="175">
                    <Border Background="#1A202C" CornerRadius="4" Width="125" HorizontalAlignment="Center"/>
                    <ContentControl Content="{Binding Cards[0]}" ContentTemplate="{StaticResource CardSnapshotTemplate}" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Cards.Count, Converter={StaticResource IntToVisibility}}"/>
                    <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Count}"/>
                    </Border>
                    <Border BorderBrush="#F6E05E" BorderThickness="3" CornerRadius="4" Width="125" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Effect="{StaticResource GoldGlow}"
                            Visibility="{Binding HasNewArrival, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- Sideboard panel: one row per distinct card in a list ("x3 Name  Element · Type").
         Draggable between the panel's three lists, or double-click to move a single copy —
         see DeckListBehavior. Hover shows the card's effect text. -->
    <DataTemplate x:Key="DeckCardRowTemplate" DataType="{x:Type vm:DeckCardGroup}">
        <Border Padding="8,4" Margin="0,0,0,2" CornerRadius="4" Cursor="Hand"
                behaviors:DeckListBehavior.IsRowDragSource="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#2D3748"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4A5568"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Hover shows the card itself (fetched the first time it's hovered — see
                 DeckCardGroup.Artwork); the name stays visible behind it until the image arrives. -->
            <Border.ToolTip>
                <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                    <Border Width="260" Height="363" CornerRadius="10" Background="#2D3748" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Name}" Foreground="#A0AEC0" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                            <Image Source="{Binding Artwork}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                </ToolTip>
            </Border.ToolTip>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Count, StringFormat='x{0}'}" Foreground="{Binding Count, Converter={StaticResource CopyCountToBrush}}" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F7FAFC" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#A0AEC0" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- The turn-phase tracker (also the Advance Phase button), shared by the meta-action bar and the
         copy layered over the Opponent panel so it stays visible there — see PhaseBarTemplate uses. -->
    <DataTemplate x:Key="PhaseBarTemplate">
        <Button Style="{StaticResource PhaseBarButtonStyle}" Command="{Binding NextPhaseCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Wake Up" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=WakeUp}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="WakeUp"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
                <TextBlock Text=" ➤ " FontSize="16" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="Materialization" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Materialization}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="Materialization"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
                <TextBlock Text=" ➤ " FontSize="16" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="Recollection" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Recollection}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="Recollection"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
                <TextBlock Text=" ➤ " FontSize="16" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="Draw" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Draw}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="Draw"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
                <TextBlock Text=" ➤ " FontSize="16" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="Main" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Main}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="Main"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
                <TextBlock Text=" ➤ " FontSize="16" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="End" FontSize="16" VerticalAlignment="Center"
                           FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=End}">
                           <TextBlock.Foreground><MultiBinding Converter="{StaticResource PhaseToBrush}" ConverterParameter="End"><Binding Path="CurrentPhase"/><Binding Path="IsMyTurn"/></MultiBinding></TextBlock.Foreground>
                       </TextBlock>
            </StackPanel>
            </Button>
    </DataTemplate>

</ResourceDictionary>
