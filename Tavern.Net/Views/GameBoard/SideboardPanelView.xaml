<UserControl x:Class="Tavern.Net.Views.GameBoard.SideboardPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:views="clr-namespace:Tavern.Net.Views"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameBoardViewModel}"
             d:DesignWidth="1600" d:DesignHeight="950">
    <!-- Sideboard panel: opens at the start of every game (and on 'N'). Sideboard on the left,
         Material over Main on the right; drag a row between lists (or double-click it) to move
         one copy — Material cards only fit in Material, everything else only in Main or the
         sideboard. Ready builds the game from whatever the lists hold; Reset puts everything back
         to the registered deck. See SideboardViewModel. -->
    <Grid
          Visibility="{Binding IsSideboardPanelOpen, Converter={StaticResource BoolToVisibility}}"
          d:IsHidden="True">
        <Border Background="#E6000000"/>

        <Border MaxWidth="1240" MaxHeight="880" Margin="24" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1A202C" BorderBrush="White" BorderThickness="2" CornerRadius="10">
            <Grid DataContext="{Binding SideboardPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <DockPanel>
                        <!-- Shown while Ready online: the lists below are dimmed and can't be changed
                             until Not Ready is pressed. -->
                        <Border DockPanel.Dock="Right" Background="#F6E05E" CornerRadius="6" Padding="10,3" VerticalAlignment="Center"
                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="DECKS LOCKED — press Not Ready to make changes" Foreground="#1A202C" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="Sideboarding" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    </DockPanel>
                    <TextBlock Foreground="#A0AEC0" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Drag a card between lists (or double-click it) to move one copy. Material cards can only go in Material; everything else in Main or the sideboard. Ready starts the game with these decks."/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sideboard -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,6">
                            <Run Text="Sideboard"/>
                            <Run Text="{Binding SideboardCount, StringFormat=' ({0})'}" Foreground="#A0AEC0"/>
                        </TextBlock>
                        <Border Background="#171923" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="8" Padding="8"
                                behaviors:DeckListBehavior.ListKind="Sideboard"
                                behaviors:DeckListBehavior.MoveCommand="{Binding MoveDeckCardCommand}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SideboardCards}" ItemTemplate="{StaticResource DeckCardRowTemplate}"/>
                                </ScrollViewer>
                                <TextBlock Text="No sideboard cards" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsSideboardEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- Material over Main -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,6">
                                <Run Text="Material"/>
                                <Run Text="{Binding MaterialCount, StringFormat=' ({0})'}" Foreground="#A0AEC0"/>
                            </TextBlock>
                            <Border Background="#171923" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="8" Padding="8"
                                    behaviors:DeckListBehavior.ListKind="Material"
                                    behaviors:DeckListBehavior.MoveCommand="{Binding MoveDeckCardCommand}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MaterialCards}" ItemTemplate="{StaticResource DeckCardRowTemplate}"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,6">
                                <Run Text="Main"/>
                                <Run Text="{Binding MainCount, StringFormat=' ({0})'}" Foreground="#A0AEC0"/>
                            </TextBlock>
                            <Border Background="#171923" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="8" Padding="8"
                                    behaviors:DeckListBehavior.ListKind="Main"
                                    behaviors:DeckListBehavior.MoveCommand="{Binding MoveDeckCardCommand}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MainCards}" ItemTemplate="{StaticResource DeckCardRowTemplate}"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <!-- Online only: both players' ready state (edits lock while you're Ready) and,
                         for the host, who goes first. The host's Start (below) enables once both
                         are Ready; the guest just waits for it. -->
                    <DockPanel Margin="0,0,0,12" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding ShowFirstPlayerChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Who goes first?" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="You" Margin="0,0,8,0" Command="{Binding Board.ChooseSelfFirstForNewGameCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Board.IsMeChosenFirstForNewGame}" Value="True">
                                                <Setter Property="BorderBrush" Value="#99F6E05E"/>
                                                <Setter Property="Effect" Value="{StaticResource GoldGlow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Opponent" Command="{Binding Board.ChooseOpponentFirstForNewGameCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Board.IsMeChosenFirstForNewGame}" Value="False">
                                                <Setter Property="BorderBrush" Value="#99F6E05E"/>
                                                <Setter Property="Effect" Value="{StaticResource GoldGlow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="You:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock DataContext="{Binding Board.IsNewGameReady}" Text="{Binding Converter={StaticResource BoolToCheckMark}}"
                                       Style="{StaticResource ReadyMarkStyle}"/>
                            <TextBlock Text="Opponent:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBlock DataContext="{Binding Board.IsOpponentNewGameReady}" Text="{Binding Converter={StaticResource BoolToCheckMark}}"
                                       Style="{StaticResource ReadyMarkStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <!-- Left side of the row: the way out (first game only) and the guest's wait
                             notice — kept apart from the deck/ready controls on the right. -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Back to Menu"
                                    Command="{Binding BackToMenuCommand}"
                                    Visibility="{Binding CanBackToMenu, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Waiting for the host to start..." Foreground="#A0AEC0" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding ShowWaitingForHost, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Reset to registered deck" Margin="0,0,8,0"
                                    Command="{Binding ResetCommand}"/>

                            <!-- Solo: Ready just starts the game. -->
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Ready" Command="{Binding ReadyCommand}"
                                    Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Online: Ready toggles; the host's Start commits once both are Ready. -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding Board.ToggleNewGameReadyCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Ready"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Board.IsNewGameReady}" Value="True">
                                                        <Setter Property="Text" Value="Not Ready"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource ActionButtonStyle}" Content="Start Game" Margin="8,0,0,0"
                                        Command="{Binding Board.StartNewGameOnlineCommand}"
                                        Visibility="{Binding Board.IsHost, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="IndianRed" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}"/>
                    </DockPanel>
                </StackPanel>

                <!-- "Move how many?" — opened by double-clicking a row with several copies. The
                     scrim absorbs clicks/drops so nothing underneath can be touched meanwhile;
                     digits/Backspace/Enter/Escape work too (SideboardViewModel.HandleKey). -->
                <Grid Grid.RowSpan="3" Visibility="{Binding IsPromptingMoveCount, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#B3000000" CornerRadius="10"/>
                    <Border MinWidth="300" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{Binding MovePromptTitle}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxWidth="320"/>
                            <TextBlock Text="{Binding MovePromptTarget}" Foreground="#A0AEC0" Margin="0,2,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseMoveCountCommand}"/>
                                <TextBlock Text="{Binding MoveCount}" FontSize="20" FontWeight="Bold" Foreground="#F7FAFC"
                                           Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseMoveCountCommand}"/>
                                <TextBlock Text="{Binding MoveCountMax, StringFormat='of {0}'}" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ActionButtonStyle}" Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelMoveCommand}"/>
                                <Button Style="{StaticResource ActionButtonStyle}" Content="Move" Command="{Binding ConfirmMoveCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
