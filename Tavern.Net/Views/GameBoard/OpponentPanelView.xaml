<UserControl x:Class="Tavern.Net.Views.GameBoard.OpponentPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:views="clr-namespace:Tavern.Net.Views"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameBoardViewModel}"
             d:DesignWidth="1600" d:DesignHeight="950">
    <!-- Opponent panel: a live version of the Major-Event snapshot viewer below, fed from
         OpponentPlayer (kept in sync by GameBoardViewModel.ApplyOpponentStateAsync/
         RefreshOpponentPanel) instead of one frozen historical snapshot. Field/Champion/
         Graveyard/Banishment reuse the exact same CardSnapshotTemplate/pile-browse machinery
         (ViewSnapshotPileCommand/ViewedSnapshotPile, ZoomSnapshotCardCommand/ZoomedSnapshotCard)
         as the snapshot viewer — those are already generic over "some CardSnapshotViewModel/
         SnapshotZoneGroup was clicked" regardless of source. Hand/Memory/Material/Main are
         redacted to a plain face-down count instead — no per-card data, no drag/tap/peek/zoom,
         since those are private zones. Auto-opens/closes on each turn handoff (IsMyTurn) but
         can also be toggled manually at any time via the header's Opponent button. -->
    <!-- The phase tracker is layered back on top of the scrim at the end of this grid (an opaque copy of
         the same template, aligned via the shared-size meta bar), so the phases stay fully visible —
         and clickable on your turn — while this panel is open. The panel's top margin clears it. -->
    <Grid
          Visibility="{Binding IsOpponentPanelOpen, Converter={StaticResource BoolToVisibility}}"
          d:IsHidden="True">
        <Button Command="{Binding ToggleOpponentPanelCommand}" Focusable="False" Cursor="Arrow">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#CC000000"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Width="1360" MaxHeight="820" Margin="40,64,40,40" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Opponent" Foreground="#F6AD55" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- One line: the opponent's Life on the left, your own on the right (adjustable
                     right here — most damage lands on the opponent's own turn, while this panel
                     is open, so reacting to it shouldn't mean closing the panel first; same
                     DecreaseLifeCommand/IncreaseLifeCommand as the header). Only the labels are
                     color-coded (orange = theirs, green = yours), as in the review panel. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Life:" FontSize="16" FontWeight="Bold" Foreground="#F6AD55" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OpponentLife}" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding OpponentLife, Converter={StaticResource LowLifeToBrush}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseLifeCommand}"/>
                        <TextBlock Text="Life:" FontSize="16" FontWeight="Bold" Foreground="#48BB78" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding Player.Life}" FontSize="16" FontWeight="Bold" Margin="6,0,10,0" VerticalAlignment="Center"
                                   Foreground="{Binding Player.Life, Converter={StaticResource LowLifeToBrush}}"/>
                        <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseLifeCommand}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="290"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Field (live, visible) then Memory/Hand redacted to a single
                             face-down "x N" box each, rather than the real per-card art the
                             live board or the snapshot viewer would show. -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Field" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border MinHeight="190" Background="#1A202C" CornerRadius="6" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding OpponentFieldCards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Margin="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartsNewGroup}" Value="True">
                                                    <Setter Property="Margin" Value="22,0,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Memory" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl Content="{Binding OpponentMemoryCount}" ContentTemplate="{StaticResource FaceDownCountTemplate}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Hand" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl Content="{Binding OpponentHandCount}" ContentTemplate="{StaticResource FaceDownCountTemplate}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Champion on a row of its own (a tapped champion needs the room), then Graveyard/
                             Banishment, then Main/Material (and Sealed, when they have any). Champion/
                             Graveyard/Banishment are real, browsable piles (ChampionPileTemplate/
                             PileBoxTemplate, always showing a count even at 0); Main/Material/Sealed
                             are face-down + count boxes, like Hand/Memory. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <ContentControl Content="{Binding OpponentChampionPile}" ContentTemplate="{StaticResource ChampionPileTemplate}"/>

                            <UniformGrid Columns="2">
                                <ContentControl Content="{Binding OpponentGraveyardPile}" ContentTemplate="{StaticResource PileBoxTemplate}"/>
                                <ContentControl Content="{Binding OpponentBanishmentPile}" ContentTemplate="{StaticResource PileBoxTemplate}"/>

                                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="Main" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl Content="{Binding OpponentMainDeckCount}" ContentTemplate="{StaticResource FaceDownCountTemplate}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="Material" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl Content="{Binding OpponentMaterialDeckCount}" ContentTemplate="{StaticResource FaceDownCountTemplate}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center"
                                            Visibility="{Binding OpponentSealedCount, Converter={StaticResource IntToVisibility}}">
                                    <TextBlock Text="Sealed" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl Content="{Binding OpponentSealedCount}" ContentTemplate="{StaticResource FaceDownCountTemplate}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Copy of the meta-action bar's phase tracker, on top of the scrim: same column split and
             margins as the real row, row height/left width shared with it, opaque backing so the
             dimmed original underneath doesn't show through. -->
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="MetaBarRow"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetaBarLeft"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetaBarRight"/>
                </Grid.ColumnDefinitions>
                <!-- Bordered like the other panels and only as wide as the bar itself; the opaque
                     background hides the dimmed original underneath. Same alignment as the real one. -->
                <Border Grid.Column="1" Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,100,0">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PhaseBarTemplate}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
