<UserControl x:Class="Tavern.Net.Views.GameBoard.RevealPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:views="clr-namespace:Tavern.Net.Views"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameBoardViewModel}"
             d:DesignWidth="1600" d:DesignHeight="950">
    <!-- Reveal panel (Actions > Reveal): the top N of Main, out of the deck and in front of you (and,
         online, the opponent). Drag any card to any zone a Main card may go — while a card is
         dragged the whole panel goes nearly transparent and stops catching the mouse (see
         IsDraggingFromRevealPanel), then returns once it lands. Next reveals one more card;
         Top/Bottom put what is left back into Main, shuffled first if Randomize is on. Modal like
         Glimpse: no scrim button, no close — it ends when the last card has gone somewhere. -->
    <Grid
          Visibility="{Binding IsRevealPanelOpen, Converter={StaticResource BoolToVisibility}}"
          d:IsHidden="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDraggingFromRevealPanel}" Value="True">
                        <Setter Property="Opacity" Value="0.05"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#CC000000"/>

        <Border MaxWidth="1200" MaxHeight="760" Margin="40" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Revealing" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Foreground="#A0AEC0" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Drag a card to any zone. Next reveals one more. Top or Bottom puts the cards still here back into Main (shuffled first if Randomize is on)."/>

                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <ToggleButton Style="{StaticResource SwitchToggleStyle}" Content="Randomize" HorizontalAlignment="Left"
                                  IsChecked="{Binding RevealRandomize, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Next" Margin="0,0,8,0" Command="{Binding RevealNextCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Top" Margin="0,0,8,0" Command="{Binding RevealToTopCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Bottom" Command="{Binding RevealToBottomCommand}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevealPanelCards}" ItemTemplate="{StaticResource CardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
