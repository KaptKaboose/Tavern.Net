<UserControl x:Class="Tavern.Net.Views.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:views="clr-namespace:Tavern.Net.Views"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameBoardViewModel}"
             d:DesignWidth="1600" d:DesignHeight="950">
    <!-- CardTemplate and the NullToVisibility converter come from Views/SharedTemplates.xaml (merged in App.xaml),
         so StackZoneView's peek popup can reuse the exact same card visual. -->
    <UserControl.Resources>
        <conv:TurnPhaseToBrushConverter x:Key="PhaseToBrush"/>
        <conv:TurnPhaseToFontWeightConverter x:Key="PhaseToFontWeight"/>
        <conv:TurnCountDisplayConverter x:Key="TurnCountDisplay"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:DieFaceToImageConverter x:Key="DieFaceToImage"/>
        <conv:BoolToPlayerLabelConverter x:Key="BoolToPlayerLabel"/>

        <!-- One pile box — real card art (or an empty dark box, via IntToVisibility, when the zone
             has no cards) plus a count badge that always shows, including 0. Click opens the full
             contents (ViewSnapshotPileCommand/ViewedSnapshotPile). Shared by the snapshot viewer's
             ViewedSnapshotPiles (an ItemsControl, so AncestorType=UserControl still resolves fine —
             it's a plain visual-tree walk regardless of ItemsControl vs. ContentControl) and the
             opponent panel's three individually-bound piles (OpponentChampionPile/
             OpponentGraveyardPile/OpponentBanishmentPile). -->
        <DataTemplate x:Key="PileBoxTemplate">
            <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Zone}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DataContext.ViewSnapshotPileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Grid Width="125" Height="175">
                        <Border Background="#1A202C" CornerRadius="4"/>
                        <ContentControl Content="{Binding Cards[0]}" ContentTemplate="{StaticResource CardSnapshotTemplate}" IsHitTestVisible="False"
                                        Visibility="{Binding Cards.Count, Converter={StaticResource IntToVisibility}}"/>
                        <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Cards.Count}"/>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Zoom overlay's status buttons: dim/plain when off, gold-bordered when on — no other
             visual state (hover/pressed) is styled since these are checked/unchecked toggles, not
             momentary actions. -->
        <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="#F6E05E"/>
                    <Setter Property="Background" Value="#4A5568"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Zoom overlay's counter +/- buttons: match the panel's dark palette instead of the
             OS-default button chrome. -->
        <Style x:Key="CounterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A5568"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ActionButtonStyle (the app's shared button look) comes from SharedTemplates.xaml,
             merged in App.xaml. -->

        <!-- Meta-action bar (Menu, Save Game): a separate, deliberately small row above the
             gameplay header, so those rarely-used actions don't compete with Life/phase/Roll/Damage
             for space — see GameBoardView's own note on why this used to be one crowded row. -->
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Snapshot viewer's tab buttons — gold-bordered while active, same highlight color used
             everywhere else in the app for an active/selected state (StatusToggleStyle, the online
             lobby's turn-order choice). -->
        <Style x:Key="PrimaryTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShowingOtherPlayerTab}" Value="False">
                    <Setter Property="BorderBrush" Value="#F6E05E"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OtherPlayerTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShowingOtherPlayerTab}" Value="True">
                    <Setter Property="BorderBrush" Value="#F6E05E"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Header's Opponent button — gold-bordered while HasUnseenOpponentActivity, same
             highlight color used everywhere else for an active/selected state. A deliberate glow
             rather than auto-opening the panel itself: the opponent shouldn't be able to yank the
             screen away from whatever the player's doing just by moving a card. Clears the instant
             the panel is actually opened, by any means (see GameBoardViewModel.
             OnIsOpponentPanelOpenChanged). -->
        <Style x:Key="OpponentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUnseenOpponentActivity}" Value="True">
                    <Setter Property="BorderBrush" Value="#F6E05E"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Meta-action bar: Menu and Save Game, kept small (CompactButtonStyle) and separate
                 from the gameplay header below so the phase tracker keeps its room. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource CompactButtonStyle}" Content="Menu" Margin="0,0,8,0" Command="{Binding BackToMenuCommand}"/>
                <Button Style="{StaticResource CompactButtonStyle}" Content="Save Game" Margin="0,0,8,0" Command="{Binding OpenSaveGamePanelCommand}"/>
                <TextBlock Text="{Binding ConnectionLostMessage}" Foreground="IndianRed" VerticalAlignment="Center"
                           Visibility="{Binding ConnectionLostMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>

            <!-- Header: life + turn (left), the turn-phase tracker (centered), Roll/Damage (right). -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseLifeCommand}"/>
                    <TextBlock Text="{Binding Player.Life, StringFormat='Life: {0}'}" FontSize="18" FontWeight="Bold"
                               Foreground="#F7FAFC" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseLifeCommand}"/>

                    <TextBlock Text="{Binding Stats.TurnCount, Converter={StaticResource TurnCountDisplay}, StringFormat='   Turn {0}'}" FontSize="18"
                               Foreground="#F7FAFC" VerticalAlignment="Center" Margin="16,0,0,0"/>

                    <!-- Online only: whose turn it currently is — drives the same IsMyTurn that
                         gates Advance Phase and auto-opens/closes the opponent panel. -->
                    <Border Background="#4A5568" CornerRadius="10" Padding="10,3" Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F7FAFC" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Opponent's Turn"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMyTurn}" Value="True">
                                            <Setter Property="Text" Value="Your Turn"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Wake Up => Materialization => Recollection => Draw => Main => End, with the
                     current phase highlighted. A fixed set of 6, so written out directly rather
                     than templated from TurnPhase's values. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Wake Up" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=WakeUp}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=WakeUp}"/>
                    <TextBlock Text=" ➤ " FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="Materialization" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=Materialization}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Materialization}"/>
                    <TextBlock Text=" ➤ " FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="Recollection" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=Recollection}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Recollection}"/>
                    <TextBlock Text=" ➤ " FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="Draw" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=Draw}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Draw}"/>
                    <TextBlock Text=" ➤ " FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="Main" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=Main}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=Main}"/>
                    <TextBlock Text=" ➤ " FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="End" FontSize="14" VerticalAlignment="Center"
                               Foreground="{Binding CurrentPhase, Converter={StaticResource PhaseToBrush}, ConverterParameter=End}"
                               FontWeight="{Binding CurrentPhase, Converter={StaticResource PhaseToFontWeight}, ConverterParameter=End}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Online only: opens the read-only opponent panel (also auto-opens/closes on
                         each turn handoff — see GameBoardViewModel.UpdateIsMyTurn). Glows gold
                         (OpponentButtonStyle) when they've done something since the panel was last
                         open. -->
                    <Button Style="{StaticResource OpponentButtonStyle}" Content="Opponent" Margin="0,0,16,0"
                            Command="{Binding ToggleOpponentPanelCommand}"
                            Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Style="{StaticResource ActionButtonStyle}" Content="Roll" Margin="0,0,16,0" Command="{Binding OpenDicePanelCommand}"/>

                    <!-- Solo only: with a real opponent, their own Life (visible in the Opponent
                         panel) is the meaningful running total — see GameBoardViewModel's own note
                         on why an arbitrary "damage dealt" tally stops meaning much online. -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseDamageDealtCommand}"/>
                        <TextBlock Text="{Binding Stats.DamageDealtCount, StringFormat='Damage: {0}'}" FontSize="18" FontWeight="Bold"
                                   Foreground="#F7FAFC" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseDamageDealtCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The board: Field, Memory, and Hand are stacked as distinct, non-overlapping regions
                 (not layered on top of each other) — Material sits to their left, Banishment/Main/
                 Graveyard to their right. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fixed (not Auto) so Hand reserves its space even when empty — Auto would
                         collapse it to zero height with no cards, shifting Memory's position
                         every time the hand size changed. Tall enough for one row of full-size
                         (125x175, +margin) cards; the Viewbox below only shrinks cards when a
                         big hand doesn't fit the row's width, not because of this height. -->
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <!-- Champion: top-left, where Material used to sit. Only Champion-type cards may
                     enter (enforced in GameSession.MoveCard) and a new arrival auto-stacks on top;
                     face-up, unlike Material/Main, since it's the champion currently in play.
                     ShowOverlay=False: no count/scrim, just the top champion's own art. -->
                <views:StackZoneView Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="0,20,0,0"
                                     Zone="{Binding Champion}" HeaderText="Champion" ShowBorder="True" ShowOverlay="False" IsZoomable="True"
                                     TargetZone="Champion" MoveCommand="{Binding MoveCardToCommand}"
                                     PeekCommand="{Binding PeekZoneCommand}"/>

                <!-- Material: moved down to roughly align with Main over in the right-hand stack
                     (approximate — that stack is a StackPanel, not a Grid, so there's no exact
                     row to match against). -->
                <views:StackZoneView Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="0,240,0,0"
                                     Zone="{Binding MaterialDeck}" HeaderText="Material" IsFaceDown="True"
                                     TargetZone="MaterialDeck" MoveCommand="{Binding MoveCardToCommand}"
                                     PeekCommand="{Binding PeekZoneCommand}"/>

                <!-- Tokens: bottom-left, roughly in line with Graveyard over in the right-hand
                     stack. A permanent, always-populated catalog — click to browse every token in
                     the game and drag one onto the Field to spawn a fresh copy (GameSession.
                     MoveToken); drag a spawned copy back here to discard it, since that's the only
                     other zone a token can ever go to. -->
                <views:StackZoneView Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="0,450,0,0"
                                     Zone="{Binding Tokens}" HeaderText="Tokens" ShowBorder="True"
                                     TargetZone="Tokens" MoveCommand="{Binding MoveCardToCommand}"
                                     PeekCommand="{Binding PeekZoneCommand}"/>

                <!-- Field: a bounded region (not the whole board) — drop a card anywhere in it and
                     it stays exactly there. No border or label. -->
                <ItemsControl x:Name="FieldItemsControl" Grid.Row="0" Grid.Column="1" Margin="8"
                              ItemsSource="{Binding Field.Cards}" ItemTemplate="{StaticResource CardTemplate}"
                              Background="Transparent"
                              behaviors:CardDropBehavior.TargetZone="Field"
                              behaviors:CardDropBehavior.MoveCommand="{Binding MoveCardToCommand}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Canvas never sizes itself to its container (it always measures as
                                 0x0, regardless of available space) — children still render/hit-test
                                 fine at their absolute positions, but the "empty" surrounding area
                                 wouldn't be part of the Canvas's own bounds at all without this,
                                 meaning it wouldn't be droppable. -->
                            <Canvas Background="Transparent"
                                    Width="{Binding ActualWidth, ElementName=FieldItemsControl}"
                                    Height="{Binding ActualHeight, ElementName=FieldItemsControl}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Instance.FieldX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Instance.FieldY}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Memory: bordered bar, upright cards, directly below Field. Shrinks to fit like
                     Hand (Viewbox, StretchDirection=DownOnly — never scales up, only down) instead
                     of scrolling, so a full row is visible at a glance rather than needing to
                     scroll through it. The drop target is a Border wrapping the Viewbox, not the
                     GroupBox itself — Viewbox is a bare Decorator with no Background of its own,
                     so once its content shrinks, the empty margin around it isn't hit-test visible
                     and drag-enter stops registering there. Same reasoning as Hand's own Border. -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="Memory" Width="950" HorizontalAlignment="Center" Margin="0,8,0,8"
                          Foreground="#F7FAFC" BorderBrush="#4A5568">
                    <Border Height="190" Background="Transparent"
                            behaviors:CardDropBehavior.TargetZone="Memory"
                            behaviors:CardDropBehavior.MoveCommand="{Binding MoveCardToCommand}">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <ItemsControl ItemsSource="{Binding Memory.Cards}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Viewbox>
                    </Border>
                </GroupBox>

                <!-- Hand: bottom, no border or label. Spans under Material too (col 0-1, not col 2 —
                     that's reserved the full height for Banishment/Main/Graveyard, so extending
                     into it would make Hand a second overlapping drop target there) for extra
                     width before a big hand needs to shrink. The Border fills the whole row
                     (Background=Transparent, same reasoning as Field's Canvas) so it's a stable,
                     permanently-present drop target no matter how small the Viewbox scales the
                     cards down to. The Viewbox only ever shrinks (StretchDirection=DownOnly) —
                     a hand that already fits renders at full size, centered. -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Background="Transparent"
                        behaviors:CardDropBehavior.TargetZone="Hand"
                        behaviors:CardDropBehavior.MoveCommand="{Binding MoveCardToCommand}">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <ItemsControl ItemsSource="{Binding Hand.Cards}" ItemTemplate="{StaticResource CardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <!-- Banishment / Main / Graveyard: right-edge column, spanning the full height. Banishment is a sideways stack. -->
                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <views:StackZoneView Margin="8,50,0,16"
                                         Zone="{Binding Banishment}" HeaderText="Banishment" ShowBorder="True" IsSideways="True"
                                         TargetZone="Banishment" MoveCommand="{Binding MoveCardToCommand}"
                                         PeekCommand="{Binding PeekZoneCommand}"/>
                    <views:StackZoneView Margin="8,20,0,16"
                                         Zone="{Binding MainDeck}" HeaderText="Main" IsFaceDown="True"
                                         TargetZone="MainDeck" MoveCommand="{Binding MoveCardToCommand}"
                                         PeekCommand="{Binding PeekZoneCommand}"/>
                    <views:StackZoneView Margin="8,20,0,0"
                                         Zone="{Binding Graveyard}" HeaderText="Graveyard" ShowBorder="True"
                                         TargetZone="Graveyard" MoveCommand="{Binding MoveCardToCommand}"
                                         PeekCommand="{Binding PeekZoneCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: stats panel -->
        <Border Grid.Column="1" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Session stats" FontSize="16" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,0,0,8"/>

                <!-- Each stat is a label/value pair (muted label, bold value) inside a shared card
                     background, rather than plain "Label: value" lines — same info, easier to scan. -->
                <Border DockPanel.Dock="Top" Background="#2D3748" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cards drawn" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.CardsDrawnCount}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Avg. cards/turn" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.AverageCardsPlayedPerTurn, StringFormat={}{0:0.0}}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Damage dealt" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.DamageDealtCount}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Life recovered" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.LifeRecoveredCount}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dead turns" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.DeadTurnsCount}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lost to Memory decay" Foreground="#A0AEC0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.CardsLostToMemoryDecayCount}" Foreground="#F7FAFC" FontWeight="Bold"/>
                        </Grid>

                        <!-- Champion level milestones as small pills rather than one-per-line —
                             there are rarely more than 2-3, so a wrapping row reads better than a
                             list. -->
                        <TextBlock Text="Champion levels" Foreground="#A0AEC0" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding Stats.ChampionLevelMilestones}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#4A5568" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Foreground="#F7FAFC" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Lv {0} · T{1}">
                                                    <Binding Path="Level"/>
                                                    <Binding Path="Turn"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Curated, always-visible log — GameStats.PlayLog still records literally every
                     action underneath, but is no longer shown directly here (see GameSession's
                     RecordMajorEvent/RecordLifeOrDamageChange). Click an entry to open a read-only
                     view of the board exactly as it was at that moment. -->
                <TextBlock DockPanel.Dock="Top" Text="Play log" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,4,0,4"/>
                <ListBox ItemsSource="{Binding Stats.MajorEvents}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsSolo, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ViewMajorEventCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left" Padding="4,2"
                                    Background="Transparent" BorderThickness="0" Foreground="#F7FAFC" Cursor="Hand">
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Turn {0}: {1}">
                                            <Binding Path="Turn" Converter="{StaticResource TurnCountDisplay}"/>
                                            <Binding Path="Description"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Online: both players' MajorEvents interleaved by real chronological order (see
                     GameBoardViewModel.MergedLog) rather than two disconnected per-player logs, so a
                     response played during the opponent's turn reads in the order it actually
                     happened. Reuses ViewMajorEventCommand as-is (CommandParameter is just the
                     underlying MajorEvent). -->
                <ListBox ItemsSource="{Binding MergedLog}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MergedLogEntry}">
                            <Button Command="{Binding DataContext.ViewMajorEventCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding Event}"
                                    HorizontalContentAlignment="Left" Padding="4,2"
                                    Background="Transparent" BorderThickness="0" Foreground="#F7FAFC" Cursor="Hand">
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · Turn {1}: {2}">
                                            <Binding Path="IsOwn" Converter="{StaticResource BoolToPlayerLabel}"/>
                                            <Binding Path="Event.Turn" Converter="{StaticResource TurnCountDisplay}"/>
                                            <Binding Path="Event.Description"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Peek overlay: clicking a pile (StackZoneView.PeekCommand) fans its cards out here,
             above the main board but below the zoom overlay so zooming a card while peeking
             still shows on top. Unlike the zoom overlay, only the scrim (not the card panel)
             closes it on click — cards inside stay draggable/right-clickable, and the panel
             scrolls instead of trying to fit an entire deck on screen at once. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding PeekedZone, Converter={StaticResource NullToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding ClosePeekCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border MaxWidth="1200" MaxHeight="820" Margin="40" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PeekedZone.HeaderText}"
                               Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:AutoScrollOnDragBehavior.IsEnabled="True">
                        <!-- Champion's own peek uses ChampionPeekCardTemplate instead of the plain
                             CardTemplate — same visual, but never shows the tapped rotation (tap/
                             flip are themselves already no-ops for a Champion card here; see
                             GameBoardViewModel.ToggleTapped/FlipCard). Every other zone's peek is
                             unaffected. -->
                        <ItemsControl ItemsSource="{Binding PeekedZone.Zone.Cards}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PeekedZone.Zone.Type}" Value="Champion">
                                            <Setter Property="ItemTemplate" Value="{StaticResource ChampionPeekCardTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Snapshot viewer: read-only board state at the moment of a clicked Major event
             (GameBoardViewModel.ViewMajorEventCommand / GameSession.TakeSnapshot). Never touches
             the live game — closing it just hides it, same as every other overlay here. Laid out
             spatially like the live board (Field/Memory/Hand directly, Field cards flowed into a
             wrapping grid rather than their live drag positions) rather than a flat list;
             Champion/Graveyard/Banishment/Material/Main render as clickable pile boxes — click one to open its full
             contents (ViewedSnapshotPile, below) — mirroring which zones StackZoneView renders as
             piles on the live board. All cards use CardSnapshotTemplate — no drag/zoom/tap/flip,
             since this is history, not the live board. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding ViewedMajorEvent, Converter={StaticResource NullToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseMajorEventViewCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="1360" MaxHeight="820" Margin="40" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <DockPanel>
                    <!-- Online only: switch between this event's own board and the opponent's
                         nearest board at roughly the same moment (ViewedOtherPlayerEvent) — everything
                         below (header line, Field/Memory/Hand, piles) follows CurrentlyViewedEvent,
                         whichever tab that currently means. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding HasOtherPlayerTab, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="{Binding PrimaryTabLabel}" Style="{StaticResource PrimaryTabButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding ShowPrimaryTabCommand}"/>
                        <Button Content="{Binding OtherTabLabel}" Style="{StaticResource OtherPlayerTabButtonStyle}"
                                Command="{Binding ShowOtherPlayerTabCommand}"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"
                               TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Turn {0}: {1}">
                                <Binding Path="CurrentlyViewedEvent.Turn" Converter="{StaticResource TurnCountDisplay}"/>
                                <Binding Path="CurrentlyViewedEvent.Description"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Foreground="#A0AEC0" Margin="0,0,0,12"
                               Visibility="{Binding CurrentlyViewedEvent, Converter={StaticResource NullToVisibility}}">
                        <Run Text="{Binding CurrentlyViewedEvent.Snapshot.Life, StringFormat='Life: {0}'}"/>
                        <Run Text="   "/>
                        <Run Text="{Binding CurrentlyViewedEvent.Snapshot.DamageDealtCount, StringFormat='Damage dealt: {0}'}"/>
                        <Run Text="   "/>
                        <Run Text="{Binding CurrentlyViewedEvent.Snapshot.Phase, StringFormat='Phase: {0}'}"/>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="No recorded state for them yet at this point." Foreground="#A0AEC0" Margin="0,0,0,12"
                               Visibility="{Binding CurrentlyViewedEvent, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                    <!-- Two fully independent columns (no RowSpan) — each sizes to its own natural
                         content and sits at the top of the shared row, rather than one stretching
                         to match the other's height. A RowSpan'd pile panel previously stretched
                         to fill the Field+Memory+Hand height and then spread that inflated space
                         evenly across its own rows (huge gaps), and the same interaction with
                         Auto-sized rows was pushing Hand out of its own visible space. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Field / Memory / Hand, stacked. -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <!-- Field: cards flow left-to-right, wrapping to new rows as needed
                                     (WrapPanel), rather than the live board's freeform x/y drag
                                     positions — reconstructing the exact saved positions turned out
                                     to be more trouble than it was worth for a read-only view. The
                                     Border has no fixed Height, so it grows to fit however many rows
                                     the cards wrap into instead of clipping them. -->
                                <TextBlock Text="Field" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border MinHeight="190" Background="#1A202C" CornerRadius="6" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding ViewedFieldCards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Margin="3"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>

                                <!-- Memory -->
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding HasViewedMemoryCards, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Memory" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ViewedMemoryCards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Hand -->
                                <StackPanel Visibility="{Binding HasViewedHandCards, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Hand" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ViewedHandCards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: piles — Champion, Graveyard, Banishment, Material, Main.
                                 Click one to open its full contents (ViewSnapshotPileCommand,
                                 below). Two per row (UniformGrid, not a width-dependent WrapPanel,
                                 so it's always exactly 2 regardless of pile count). VerticalAlignment
                                 Top keeps it sized to its own content instead of stretching to
                                 match the left column's height. -->
                            <ItemsControl Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding ViewedSnapshotPiles}"
                                          ItemTemplate="{StaticResource PileBoxTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Glimpse overlay: 'G' draws the top card of Main into Staging (and opens this if not
             already open); every later 'G' press draws another, appending to Staging. Drag cards
             from Staging into Top or Bottom to sort them — dropping directly on another card
             there inserts before it (GlimpseDropBehavior.InsertBefore, set per-item via
             ItemContainerStyle), dropping on empty space appends to the end. The instant Staging
             empties out, every sorted card is reinserted into Main (Top's order lands on top,
             Bottom's order at the bottom — see GameSession.FinishGlimpse) and this closes
             automatically. No manual close: nothing but G does anything while glimpsing
             (GameBoardViewModel.HandleKey enforces that), so there's no scrim button here either. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsGlimpsing, Converter={StaticResource BoolToVisibility}}"
              d:IsHidden="True">
            <Border Background="#CC000000"/>

            <Border MaxWidth="1200" MaxHeight="860" Margin="40" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Glimpsing" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Foreground="#A0AEC0" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Press G to draw another card. Drag cards into Top or Bottom — drop on a card to insert before it, or on empty space to add it to the end. Closes automatically once every drawn card is sorted."/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  behaviors:AutoScrollOnDragBehavior.IsEnabled="True">
                        <StackPanel>
                            <TextBlock Text="Drawn" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding GlimpseStaging}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="Top" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="Transparent" MinHeight="181" Margin="0,0,0,16"
                                    behaviors:GlimpseDropBehavior.Target="Top"
                                    behaviors:GlimpseDropBehavior.MoveCommand="{Binding MoveGlimpseCardCommand}">
                                <ItemsControl ItemsSource="{Binding GlimpseTop}" ItemTemplate="{StaticResource CardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="behaviors:GlimpseDropBehavior.Target" Value="Top"/>
                                            <Setter Property="behaviors:GlimpseDropBehavior.MoveCommand" Value="{Binding Board.MoveGlimpseCardCommand}"/>
                                            <Setter Property="behaviors:GlimpseDropBehavior.InsertBefore" Value="{Binding}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Border>

                            <TextBlock Text="Bottom" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="Transparent" MinHeight="181"
                                    behaviors:GlimpseDropBehavior.Target="Bottom"
                                    behaviors:GlimpseDropBehavior.MoveCommand="{Binding MoveGlimpseCardCommand}">
                                <ItemsControl ItemsSource="{Binding GlimpseBottom}" ItemTemplate="{StaticResource CardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="behaviors:GlimpseDropBehavior.Target" Value="Bottom"/>
                                            <Setter Property="behaviors:GlimpseDropBehavior.MoveCommand" Value="{Binding Board.MoveGlimpseCardCommand}"/>
                                            <Setter Property="behaviors:GlimpseDropBehavior.InsertBefore" Value="{Binding}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Save Game overlay: click Save Game in the header to open, name it, and Save — the board
             has no persistent "management" screen of its own, so this is a modal panel rather than
             DeckImportView's inline Save Deck row. Stays open after a successful save so the
             confirmation is visible; Close (or the scrim) dismisses it. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsSavingGame, Converter={StaticResource BoolToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseSaveGamePanelCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border MaxWidth="420" MinWidth="360" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Save Game" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding SaveGameName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Save" Command="{Binding ConfirmSaveGameCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Close" Margin="8,0,0,0" Command="{Binding CloseSaveGamePanelCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SaveGameStatusMessage}" Foreground="#68D391" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding SaveGameStatusMessage, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Opponent panel: a live version of the Major-Event snapshot viewer below, fed from
             OpponentPlayer (kept in sync by GameBoardViewModel.ApplyOpponentStateAsync/
             RefreshOpponentPanel) instead of one frozen historical snapshot. Field/Champion/
             Graveyard/Banishment reuse the exact same CardSnapshotTemplate/pile-browse machinery
             (ViewSnapshotPileCommand/ViewedSnapshotPile, ZoomSnapshotCardCommand/ZoomedSnapshotCard)
             as the snapshot viewer — those are already generic over "some CardSnapshotViewModel/
             SnapshotZoneGroup was clicked" regardless of source. Hand/Memory/Material/Main are
             redacted to a plain face-down count instead — no per-card data, no drag/tap/peek/zoom,
             since those are private zones. Auto-opens/closes on each turn handoff (IsMyTurn) but
             can also be toggled manually at any time via the header's Opponent button. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsOpponentPanelOpen, Converter={StaticResource BoolToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding ToggleOpponentPanelCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="1360" MaxHeight="820" Margin="40" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Opponent's board" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Foreground="#A0AEC0" Margin="0,0,0,12">
                        <Run Text="{Binding OpponentLife, StringFormat='Life: {0}'}"/>
                        <Run Text="   "/>
                        <Run Text="{Binding OpponentTurnCount, Converter={StaticResource TurnCountDisplay}, StringFormat='Turn: {0}'}"/>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Field (live, visible) then Memory/Hand redacted to a single
                                 face-down "x N" box each, rather than the real per-card art the
                                 live board or the snapshot viewer would show. -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Field" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border MinHeight="190" Background="#1A202C" CornerRadius="6" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding OpponentFieldCards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Margin="3"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Memory" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Grid Width="125" Height="175">
                                            <Image Source="pack://application:,,,/GameData/Images/Grand%20Archive%20Back.jpg" Stretch="UniformToFill"/>
                                            <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding OpponentMemoryCount}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Hand" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Grid Width="125" Height="175">
                                            <Image Source="pack://application:,,,/GameData/Images/Grand%20Archive%20Back.jpg" Stretch="UniformToFill"/>
                                            <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding OpponentHandCount}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Champion/Material, Graveyard/Banishment, Main — same order and
                                 pairing as the snapshot viewer's own SnapshotPileOrder. Champion/
                                 Graveyard/Banishment are real, browsable piles (PileBoxTemplate,
                                 always showing a count even at 0 — see its own comment); Material/Main
                                 are the same redacted face-down + count boxes as Hand/Memory. -->
                            <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Top">
                                <ContentControl Content="{Binding OpponentChampionPile}" ContentTemplate="{StaticResource PileBoxTemplate}"/>

                                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="Material" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Width="125" Height="175">
                                        <Image Source="pack://application:,,,/GameData/Images/Grand%20Archive%20Back.jpg" Stretch="UniformToFill"/>
                                        <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding OpponentMaterialDeckCount}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <ContentControl Content="{Binding OpponentGraveyardPile}" ContentTemplate="{StaticResource PileBoxTemplate}"/>
                                <ContentControl Content="{Binding OpponentBanishmentPile}" ContentTemplate="{StaticResource PileBoxTemplate}"/>

                                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="Main" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Width="125" Height="175">
                                        <Image Source="pack://application:,,,/GameData/Images/Grand%20Archive%20Back.jpg" Stretch="UniformToFill"/>
                                        <Border Background="#CC000000" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding OpponentMainDeckCount}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Snapshot pile popup: full contents of a clicked pile box (Champion/Graveyard/
             Banishment/Material/Main), shared by both the snapshot viewer and the Opponent panel
             above — declared after both so it always renders on top of whichever one it popped out
             of, rather than being pinned above just one of them. Read-only either way — closing it
             just hides it. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding ViewedSnapshotPile, Converter={StaticResource NullToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseSnapshotPileViewCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border MaxWidth="1200" MaxHeight="820" Margin="40" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ViewedSnapshotPile.Zone}"
                               Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ViewedSnapshotPile.Cards}" ItemTemplate="{StaticResource CardSnapshotTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Roll Dice overlay: click Roll in the header to open, set a count with the +/- pair,
             then click Roll inside the panel to actually roll — each die cycles random faces on a
             shared clock (GameBoardViewModel.RollDice/OnDiceAnimationTick) before settling on its
             real, already-decided result and picking up a gold highlight border. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsRollingDice, Converter={StaticResource BoolToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseDicePanelCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border MaxWidth="700" MinWidth="360" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Roll Dice" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseDiceToRollCommand}"/>
                        <TextBlock Text="{Binding DiceToRoll, StringFormat='Dice: {0}'}" FontSize="18" FontWeight="Bold"
                                   Foreground="#F7FAFC" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseDiceToRollCommand}"/>

                        <Button Style="{StaticResource ActionButtonStyle}" Content="Roll" Margin="24,0,0,0" Command="{Binding RollDiceCommand}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Dice}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DieViewModel}">
                                <Border Width="64" Height="64" Margin="6" CornerRadius="6" BorderThickness="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#F6E05E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding FaceValue, Converter={StaticResource DieFaceToImage}}" Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Zoom overlay: right-click any card (CardZoomBehavior) opens it here full-size, with a
             side panel for its status/counter. The scrim and the card art are each their own
             click-to-close Button (matching the old "click anywhere on the card closes it"
             behavior); the side panel is deliberately NOT inside either of those, since its own
             toggle/+-/- clicks need to change this card's state instead of closing the overlay. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding ZoomedCard, Converter={StaticResource NullToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseZoomCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding CloseZoomCommand}" Focusable="False" Cursor="Arrow">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="420" Height="588" CornerRadius="10" ClipToBounds="True"
                                    Background="#333" BorderBrush="Black" BorderThickness="2">
                                <Grid>
                                    <Image Source="{Binding ZoomedCard.Artwork}" Stretch="Uniform"
                                           Visibility="{Binding ZoomedCard.Artwork, Converter={StaticResource NullToVisibility}}"/>
                                    <TextBlock Text="{Binding ZoomedCard.Name}" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="White" FontSize="28" Margin="16"
                                               Visibility="{Binding ZoomedCard.Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Status/counter side panel — only relevant in play (Field/Champion; see
                     GameBoardViewModel.ShowCounterAndStatusPanel), hidden everywhere else (Hand,
                     a deck peek, Glimpse, ...). Status buttons two-way bind straight to the
                     CardInstance's own IsXxx properties (no command/parameter plumbing needed);
                     highlighted (gold border) when checked via the StatusToggleStyle below. -->
                <Border Width="170" Margin="16,0,0,0" Padding="14" VerticalAlignment="Center"
                        Background="#2D3748" BorderBrush="White" BorderThickness="2" CornerRadius="10"
                        Visibility="{Binding ShowCounterAndStatusPanel, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- Status/Tap toggles bind IsChecked OneWay (display only) and drive the
                             actual change through a Command instead — routing through
                             GameSession.ToggleStatus/ToggleTapped so it's logged and (for Tap)
                             breaks any open Life/Damage coalescing streak. A TwoWay binding here
                             would double-toggle: WPF flips IsChecked itself on click, then the
                             command would flip the real property again. -->
                        <TextBlock Text="Status" Foreground="#F7FAFC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsEphemeral, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Ephemeral">
                                <Image Source="/GameData/Images/Tokens/ephemeral.png" Stretch="Uniform"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsIgnited, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Ignited">
                                <Image Source="/GameData/Images/Tokens/ignited.png" Stretch="Uniform"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsImbued, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Imbued">
                                <Image Source="/GameData/Images/Tokens/imbued.png" Stretch="Uniform"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsRanged, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Ranged">
                                <Image Source="/GameData/Images/Tokens/ranged.png" Stretch="Uniform"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsRooted, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Rooted">
                                <Image Source="/GameData/Images/Tokens/rooted.png" Stretch="Uniform"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StatusToggleStyle}" IsChecked="{Binding ZoomedCard.Instance.IsWarded, Mode=OneWay}"
                                          Command="{Binding ToggleZoomedCardStatusCommand}" CommandParameter="Warded">
                                <Image Source="/GameData/Images/Tokens/warded.png" Stretch="Uniform"/>
                            </ToggleButton>
                        </UniformGrid>

                        <TextBlock Text="Counter" Foreground="#F7FAFC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource CounterButtonStyle}" Content="-" Command="{Binding DecreaseCounterCommand}"/>
                            <TextBlock Text="{Binding ZoomedCard.Instance.Counter}" FontSize="20" FontWeight="Bold" Foreground="#F7FAFC"
                                       Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource CounterButtonStyle}" Content="+" Command="{Binding IncreaseCounterCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Tapped" Foreground="#F7FAFC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <ToggleButton Style="{StaticResource StatusToggleStyle}" HorizontalAlignment="Center"
                                      IsChecked="{Binding ZoomedCard.Instance.IsTapped, Mode=OneWay}"
                                      Command="{Binding ToggleZoomedCardTappedCommand}">
                            <TextBlock Text="Tap" Foreground="#F7FAFC" FontWeight="Bold" FontSize="14"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Snapshot zoom overlay: right-click a card in the review panel (CardZoomBehavior routes
             CardSnapshotViewModel to ZoomSnapshotCardCommand) opens it here full-size. No
             status/counter side panel like the live Zoom overlay above — a snapshot is read-only,
             nothing here is editable. Always shows FrontArtwork, the card's true printed face,
             rather than whatever face happens to be showing on the board: the player owns every
             card in their own snapshot, so there's no reason to hide it from them even if it's
             currently flipped face-down. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding ZoomedSnapshotCard, Converter={StaticResource NullToVisibility}}"
              d:IsHidden="True">
            <Button Command="{Binding CloseSnapshotZoomCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Command="{Binding CloseSnapshotZoomCommand}" Focusable="False" Cursor="Arrow"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="420" Height="588" CornerRadius="10" ClipToBounds="True"
                                Background="#333" BorderBrush="Black" BorderThickness="2">
                            <Grid>
                                <Image Source="{Binding ZoomedSnapshotCard.FrontArtwork}" Stretch="Uniform"
                                       Visibility="{Binding ZoomedSnapshotCard.FrontArtwork, Converter={StaticResource NullToVisibility}}"/>
                                <TextBlock Text="{Binding ZoomedSnapshotCard.Snapshot.Card.Name}" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="White" FontSize="28" Margin="16"
                                           Visibility="{Binding ZoomedSnapshotCard.FrontArtwork, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
