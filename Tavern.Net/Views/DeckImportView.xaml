<UserControl x:Class="Tavern.Net.Views.DeckImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DeckImportViewModel}"
             d:DesignWidth="900" d:DesignHeight="650">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:ResolutionStatusToBrushConverter x:Key="StatusToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: paste box -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Paste your decklist" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="Gray"
                       Text="One card per line, e.g. '4 Card Name'. Supports Omnidex-style '# Main Deck' / '# Material Deck' / '# Sideboard' headers, or 'Main:' / 'Material:' style; otherwise cards are auto-sorted by type."/>
            <Button DockPanel.Dock="Bottom" Content="Import" Margin="0,8,0,0" Padding="12,6"
                    HorizontalAlignment="Left"
                    Command="{Binding ImportCommand}"/>
            <TextBox Text="{Binding DecklistText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"/>
        </DockPanel>

        <!-- Right: resolution results -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Resolved cards" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="IndianRed" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                       TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Bottom" Content="Start Game" Margin="0,8,0,0" Padding="12,6"
                    HorizontalAlignment="Left"
                    Command="{Binding StartGameCommand}"
                    IsEnabled="{Binding CanStartGame}"/>
            <ListBox ItemsSource="{Binding ResolvedLines}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ResolvedLineViewModel}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SourceLine.Quantity, StringFormat={}{0}x}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SourceLine.CardName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding EffectiveSection}" Foreground="Gray"/>

                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding Candidates}"
                                      SelectedItem="{Binding SelectedCard}"
                                      DisplayMemberPath="Name"
                                      Visibility="{Binding ShowCandidatePicker, Converter={StaticResource BoolToVisibility}}"
                                      MinWidth="180"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
