<UserControl x:Class="Tavern.Net.Views.DeckImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DeckImportViewModel}"
             d:DesignWidth="900" d:DesignHeight="650">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:ResolutionStatusToBrushConverter x:Key="StatusToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="&lt; Back to Menu" Style="{StaticResource ActionButtonStyle}"
                HorizontalAlignment="Left" Margin="0,0,0,16" Command="{Binding BackCommand}"/>

        <!-- Deck management: load an already-saved deck, or save whatever's currently resolved on
             the right under a name. Kept as one prominent panel up top rather than buried among the
             import controls, since this is the main reason "Change Deck" exists as its own screen. -->
        <Border Grid.Row="1" Background="#2D3748" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Load a saved deck" FontSize="16" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="220" ItemsSource="{Binding SavedDecks}" SelectedItem="{Binding SelectedSavedDeck}"
                                  DisplayMemberPath="Name"/>
                        <Button Content="Load" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding LoadDeckCommand}" CommandParameter="{Binding SelectedSavedDeck}"/>
                        <Button Content="Delete" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding DeleteDeckCommand}" CommandParameter="{Binding SelectedSavedDeck}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Save this deck" FontSize="16" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="200" VerticalContentAlignment="Center"
                                 Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Save Deck" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding SaveDeckCommand}"
                                ToolTip="Saves the resolved cards below under this name and sets it as your active deck."/>
                    </StackPanel>
                    <TextBlock Text="{Binding SaveStatusMessage}" Foreground="#68D391" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding SaveStatusMessage, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: paste box -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Paste your decklist" FontSize="18" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#A0AEC0"
                           Text="One card per line, e.g. '4 Card Name'. Supports Omnidex-style '# Main Deck' / '# Material Deck' / '# Sideboard' headers, or 'Main:' / 'Material:' style; otherwise cards are auto-sorted by type."/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Import" Style="{StaticResource ActionButtonStyle}" Command="{Binding ImportCommand}"/>
                    <Button Content="Clear Cache" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Command="{Binding ClearCacheCommand}"
                            ToolTip="Deletes cached card data and images, so the next import re-fetches everything from the API."/>
                    <TextBlock Text="{Binding CacheStatusMessage}" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBox Text="{Binding DecklistText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </DockPanel>

            <!-- Right: resolution results -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Resolved cards" FontSize="18" FontWeight="Bold" Foreground="#F7FAFC" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Top" Text="Loading..." Foreground="#A0AEC0" Margin="0,0,0,8"
                           Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="IndianRed" Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                           TextWrapping="Wrap"/>

                <!-- Start Game only shows up when this screen stood in for "pick a deck to play now"
                     (Solo with no active deck yet) — see DeckImportViewModel.AllowStartGame. -->
                <Button DockPanel.Dock="Bottom" Content="Start Game" Style="{StaticResource ActionButtonStyle}"
                        Margin="0,8,0,0" HorizontalAlignment="Left"
                        Command="{Binding StartGameCommand}"
                        IsEnabled="{Binding CanStartGame}"
                        Visibility="{Binding AllowStartGame, Converter={StaticResource BoolToVisibility}}"/>

                <ListBox ItemsSource="{Binding ResolvedLines}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ResolvedLineViewModel}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SourceLine.Quantity, StringFormat={}{0}x}"/>
                                <TextBlock Grid.Column="2" Text="{Binding SourceLine.CardName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding EffectiveSection}" Foreground="Gray"/>

                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedCard}"
                                          DisplayMemberPath="Name"
                                          Visibility="{Binding ShowCandidatePicker, Converter={StaticResource BoolToVisibility}}"
                                          MinWidth="180"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
