<UserControl x:Class="Tavern.Net.Views.StackZoneView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="{Binding HeaderText, ElementName=Root}" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <!-- The pile itself: a plain count. Click to peek at (and drag/right-click) the actual cards. -->
        <Border x:Name="PileBorder" Background="#222" CornerRadius="4" Cursor="Hand"
                MouseLeftButtonUp="OnPileClicked"
                behaviors:CardDropBehavior.TargetZone="{Binding TargetZone, ElementName=Root}"
                behaviors:CardDropBehavior.MoveCommand="{Binding MoveCommand, ElementName=Root}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="90"/>
                    <Setter Property="Height" Value="126"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSideways, ElementName=Root}" Value="True">
                            <Setter Property="Width" Value="126"/>
                            <Setter Property="Height" Value="90"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowBorder, ElementName=Root}" Value="True">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#55000000"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Zone.Cards.Count, ElementName=Root}" Foreground="White" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Popup x:Name="PeekPopup" PlacementTarget="{Binding ElementName=PileBorder}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#EEE" BorderBrush="Black" BorderThickness="1" CornerRadius="4" Padding="6">
                <ItemsControl ItemsSource="{Binding Zone.Cards, ElementName=Root}"
                              ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="400"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
