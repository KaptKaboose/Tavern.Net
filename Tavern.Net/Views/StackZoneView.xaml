<UserControl x:Class="Tavern.Net.Views.StackZoneView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
             xmlns:behaviors="clr-namespace:Tavern.Net.Behaviors"
             xmlns:conv="clr-namespace:Tavern.Net.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>

        <!-- Shared by the pile box and its art layer so both always size identically —
             one Width/Height/IsSideways swap instead of keeping two copies in sync. -->
        <Style x:Key="PileSizeStyle" TargetType="FrameworkElement">
            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="175"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSideways, ElementName=Root}" Value="True">
                    <Setter Property="Width" Value="175"/>
                    <Setter Property="Height" Value="125"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="{Binding HeaderText, ElementName=Root}" FontWeight="Bold" Foreground="#F7FAFC"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <!-- The pile: a background image (the top card's own art for Graveyard/Banishment, or a
             generic back for face-down Material/Main) under the existing translucent scrim, which
             keeps the white count legible over whatever's showing through. Click to peek at (and
             drag/right-click) the actual cards. -->
        <Grid Style="{StaticResource PileSizeStyle}">
            <!-- Rotates the top card's art (+ its badges) in place when tapped — same mechanism
                 as CardTemplate's own Border (RenderTransform, not LayoutTransform, so it spins
                 around its center without affecting this Grid's fixed footprint). Only Champion
                 currently ever sets IsTapped on a card sitting in a StackZoneView pile (Material/
                 Main/Graveyard/Banishment cards get untapped by MoveCard the moment they land in
                 a non-Field/Champion zone), so this is a no-op everywhere else. -->
            <!-- The zone's outline (ShowBorder), drawn beneath the card art rather than on the
                 click/drop overlay further down — otherwise it renders on top of the card image. -->
            <Border CornerRadius="4" BorderBrush="#55000000" BorderThickness="1" IsHitTestVisible="False"
                    Visibility="{Binding ShowBorder, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>

            <Border CornerRadius="4" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="RenderTransform">
                            <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Zone.Cards[0].Instance.IsTapped, ElementName=Root}" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Generic face-down back for Material/Main — a bundled asset (not fetched
                         from the API: it's per-card via other_orientations, which is only ever
                         populated for genuinely double-faced cards, empty for an ordinary deck). -->
                    <Image Stretch="UniformToFill" Source="/GameData/Images/Grand%20Archive%20Back.jpg">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFaceDown, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Fixed at the card's own portrait size and rotated when the pile is
                         sideways — matches CardTemplate's IsTapped rotation, so Banishment's art
                         reads correctly instead of just showing an unrotated slice of a portrait
                         card. LayoutTransform, not RenderTransform: it applies during measure/
                         arrange, so WPF treats the rotated 175x125 footprint as this element's
                         real size and centers it exactly — RenderTransform only rotates after
                         layout is already finalized around the pre-rotation 125x175 box, which is
                         what left it overflowing/cut off on the sides. -->
                    <Image Width="125" Height="175" Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Source="{Binding Zone.Cards[0].Artwork, ElementName=Root}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFaceDown, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSideways, ElementName=Root}" Value="True">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Status/counter badges for the top card — same tiny, non-interactive
                         overlay as CardTemplate's (see SharedTemplates.xaml), reproduced here
                         since this pile's art isn't rendered through CardTemplate at all. Only
                         ever populated in practice on Champion (the one pile with ShowOverlay=
                         False — everywhere else the reset rule already guarantees Counter/status
                         are cleared, so this stays empty there regardless).

                         Gated on Zone.Cards.Count rather than trusting each Cards[0].Instance.*
                         binding to resolve on its own: an indexer binding into an EMPTY collection
                         fails silently, and WPF then leaves Visibility at its unbound default —
                         which is Visible, not Collapsed — so without this wrapper every badge (and
                         an empty counter pill) showed up on a pile with no cards in it at all. -->
                    <Grid Visibility="{Binding Zone.Cards.Count, ElementName=Root, Converter={StaticResource IntToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Margin="3" IsHitTestVisible="False">
                            <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ephemeral.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsEphemeral, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ignited.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsIgnited, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/imbued.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsImbued, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/ranged.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsRanged, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Width="16" Height="16" Margin="0,0,1,0" Source="/GameData/Images/Tokens/rooted.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsRooted, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Width="16" Height="16" Source="/GameData/Images/Tokens/warded.png"
                                   Visibility="{Binding Zone.Cards[0].Instance.IsWarded, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <Border Background="#CC000000" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="3" IsHitTestVisible="False">
                            <Border.Visibility>
                                <Binding Path="Zone.Cards[0].Instance.Counter" ElementName="Root" Converter="{StaticResource IntToVisibility}"/>
                            </Border.Visibility>
                            <TextBlock Text="{Binding Zone.Cards[0].Instance.Counter, ElementName=Root}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="PileBorder" Cursor="Hand"
                    MouseLeftButtonUp="OnPileClicked"
                    PreviewMouseRightButtonDown="OnPileRightClicked"
                    behaviors:CardDropBehavior.TargetZone="{Binding TargetZone, ElementName=Root}"
                    behaviors:CardDropBehavior.MoveCommand="{Binding MoveCommand, ElementName=Root}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PileSizeStyle}">
                        <Setter Property="Background" Value="#99222222"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <!-- ShowOverlay=False (Champion): keep the Border for hit-testing/drop,
                                 but drop the scrim so the top card art shows through plainly. -->
                            <DataTrigger Binding="{Binding ShowOverlay, ElementName=Root}" Value="False">
                                <Setter Property="Background" Value="Transparent"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Zone.Cards.Count, ElementName=Root}" Foreground="White" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowOverlay, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
