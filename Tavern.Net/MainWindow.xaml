<Window x:Class="Tavern.Net.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tavern.Net.ViewModels"
        xmlns:views="clr-namespace:Tavern.Net.Views"
        mc:Ignorable="d"
        Title="Tavern.Net" Height="850" Width="1400" MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="Icon.ico"
        Background="#1A202C"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartMenuViewModel}">
            <views:StartMenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeckImportViewModel}">
            <views:DeckImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavedGamesViewModel}">
            <views:SavedGamesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnlineLobbyViewModel}">
            <views:OnlineLobbyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameBoardViewModel}">
            <views:GameBoardView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Every view is always laid out at the 1600x950 design size and then scaled uniformly to fit
         the window (letterboxed if the aspect ratio differs) — keeps the "no resize glitches"
         property of a locked window while still fitting small/high-DPI screens. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="950">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Viewbox>
</Window>
